# PostgreSQL
DATABASE_URL="postgresql://kdipl:kdipl_dev@localhost:5432/kdipl?schema=public"
TEST_DATABASE_URL="postgresql://kdipl:kdipl_test@localhost:5433/kdipl_test?schema=public"

# Application and sessions
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SESSION_ABSOLUTE_HOURS="12"
SESSION_IDLE_MINUTES="120"
AUTH_RATE_LIMIT_ATTEMPTS="5"
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"

# Development bootstrap administrator (used only by the seed command)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Storage: local | s3
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_LOCAL_PATH=".data/uploads"
FILE_STORAGE_BUCKET=""
FILE_STORAGE_REGION=""
FILE_STORAGE_ENDPOINT=""
FILE_STORAGE_ACCESS_KEY_ID=""
FILE_STORAGE_SECRET_ACCESS_KEY=""
FILE_STORAGE_FORCE_PATH_STYLE="false"
FILE_STORAGE_MAX_BYTES="10485760"

# Logging
LOG_LEVEL="info"
