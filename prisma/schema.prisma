model PurchaseOrder {
  id                          String                   @id @default(uuid()) @db.Uuid
  poNumber                    String                   @unique @db.VarChar(30)
  rfqId                       String                   @unique @db.Uuid
  quotationId                 String                   @unique @db.Uuid
