// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  SEND_BACK
  RECOMMEND
  CANCEL
  VERIFY
  RECEIVE
  ISSUE
  TRANSFER
  ADJUST
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  VIEW
  EXPORT
  DOWNLOAD
}

enum StockValuationMethod {
  MOVING_WEIGHTED_AVERAGE
  FIFO
  LAST_APPROVED_PURCHASE_RATE
  QUANTITY_ONLY
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRY_QUEUED
}

enum StorageProvider {
  LOCAL
  S3
}

enum FileScanStatus {
  QUARANTINED
  CLEAN
  REJECTED
  SCAN_FAILED
}

enum GoodsReceiptDocumentType {
  DELIVERY_CHALLAN
  MATERIAL_PHOTO
  SUPPLIER_INVOICE
  RECEIVER_SIGNATURE
}

enum PurchaseOrderAmendmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum NegativeStockExceptionStatus {
  OPEN
  RESOLVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SiteStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectAssignmentRole {
  PROJECT_MANAGER
  PROJECT_MEMBER
}

enum SiteAssignmentRole {
  SITE_SUPERVISOR
  SITE_MEMBER
}

enum MaterialRequirementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaterialRequirementSubmitterRole {
  SITE_SUPERVISOR
  PROJECT_MANAGER
}

enum MaterialRequirementWorkflowAction {
  SUBMIT
  APPROVE
  REJECT
  SEND_BACK
}

enum RequestForQuotationStatus {
  DRAFT
  ISSUED
  RECOMMENDED
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestForQuotationWorkflowAction {
  ISSUE
  RECOMMEND
  APPROVE
  REJECT
  SEND_BACK
  CANCEL
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  ACCEPTED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum InventoryLocationType {
  CENTRAL_STORE
  PROJECT_STORE
  SITE_STORE
  TEMPORARY_STORE
  TRANSIT
  DAMAGED_REJECTED
}

enum GoodsReceiptStatus {
  DRAFT
  PHYSICALLY_VERIFIED
  PENDING_PM_APPROVAL
  POSTED
  CANCELLED
}

enum GoodsReceiptExceptionType {
  DAMAGED
  REJECTED
}

enum GoodsReceiptExceptionStatus {
  OPEN
  REPLACEMENT_EXPECTED
  RETURN_PENDING
  RETURNED
  RESOLVED
}

enum StockTransactionType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @unique @db.VarChar(120)
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  positions   Position[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  code         String      @unique @db.VarChar(50)
  name         String      @unique @db.VarChar(120)
  description  String?
  isActive     Boolean     @default(true)
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
  @@index([isActive])
}

model Employee {
  id                 String              @id @default(uuid()) @db.Uuid
  employeeCode       String              @unique @db.VarChar(50)
  fullName           String              @db.VarChar(160)
  designation        String?             @db.VarChar(120)
  email              String?             @db.VarChar(320)
  mobile             String?             @db.VarChar(30)
  isActive           Boolean             @default(true)
  departmentId       String?             @db.Uuid
  positionId         String?             @db.Uuid
  managerId          String?             @db.Uuid
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?           @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("EmployeeManager")
  user               User?
  projectAssignments ProjectAssignment[]
  siteAssignments    SiteAssignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([isActive])
}

model User {
  movementRequests                 CustomerStockMovement[]            @relation("MovementCreator")
  movementUpdates                  CustomerStockMovement[]            @relation("MovementActor")
  movementApprovals                CustomerStockMovement[]            @relation("MovementApprover")
  movementDispatches               CustomerStockMovement[]            @relation("MovementDispatcher")
  stockClosures                    ProjectStockClosure[]
  id                               String                             @id @default(uuid()) @db.Uuid
  email                            String                             @db.VarChar(320)
  emailNormalized                  String                             @unique @db.VarChar(320)
  passwordHash                     String
  displayName                      String                             @db.VarChar(160)
  status                           UserStatus                         @default(ACTIVE)
  authVersion                      Int                                @default(1)
  mustChangePassword               Boolean                            @default(false)
  passwordChangedAt                DateTime?
  lastLoginAt                      DateTime?
  employeeId                       String?                            @unique @db.Uuid
  employee                         Employee?                          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles                            UserRole[]
  sessions                         Session[]
  auditEvents                      AuditLog[]                         @relation("AuditActor")
  uploadedFiles                    FileRecord[]
  purchaseOrderAmendmentsCreated   PurchaseOrderAmendment[]           @relation("PurchaseOrderAmendmentCreator")
  purchaseOrderAmendmentsDecided   PurchaseOrderAmendment[]           @relation("PurchaseOrderAmendmentDecisionActor")
  goodsReceiptsSiteAcknowledged    GoodsReceipt[]                     @relation("GoodsReceiptSiteAcknowledger")
  negativeStockExceptionsCreated   TemporaryNegativeStockException[]  @relation("NegativeStockExceptionCreator")
  materialRequirementsCreated      MaterialRequirement[]              @relation("MaterialRequirementCreator")
  materialRequirementsSubmitted    MaterialRequirement[]              @relation("MaterialRequirementSubmitter")
  materialRequirementsDecided      MaterialRequirement[]              @relation("MaterialRequirementDecisionActor")
  materialRequirementEvents        MaterialRequirementWorkflowEvent[]
  requestsForQuotationCreated      RequestForQuotation[]              @relation("RequestForQuotationCreator")
  requestsForQuotationIssued       RequestForQuotation[]              @relation("RequestForQuotationIssuer")
  requestsForQuotationRecommended  RequestForQuotation[]              @relation("RequestForQuotationRecommender")
  requestsForQuotationDecided      RequestForQuotation[]              @relation("RequestForQuotationDecisionActor")
  requestForQuotationEvents        RequestForQuotationWorkflowEvent[]
  supplierQuotationsRecorded       SupplierQuotation[]                @relation("SupplierQuotationRecorder")
  purchaseOrdersCreated            PurchaseOrder[]                    @relation("PurchaseOrderCreator")
  purchaseOrdersIssued             PurchaseOrder[]                    @relation("PurchaseOrderIssuer")
  purchaseOrderAcceptancesRecorded PurchaseOrder[]                    @relation("PurchaseOrderAcceptanceRecorder")
  purchaseOrdersClosed             PurchaseOrder[]                    @relation("PurchaseOrderCloser")
  purchaseOrdersCancelled          PurchaseOrder[]                    @relation("PurchaseOrderCanceller")
  goodsReceiptsCreated             GoodsReceipt[]                     @relation("GoodsReceiptCreator")
  goodsReceiptsVerified            GoodsReceipt[]                     @relation("GoodsReceiptVerifier")
  goodsReceiptsApproved            GoodsReceipt[]                     @relation("GoodsReceiptApprover")
  goodsReceiptsPosted              GoodsReceipt[]                     @relation("GoodsReceiptPoster")
  goodsReceiptsCancelled           GoodsReceipt[]                     @relation("GoodsReceiptCanceller")
  stockTransactionsCreated         StockTransaction[]                 @relation("StockTransactionCreator")
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @unique @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  userId            String    @db.Uuid
  authVersion       Int
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  userAgent         String?   @db.VarChar(500)
  ipHash            String?   @db.Char(64)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String      @db.VarChar(120)
  entityId    String      @db.VarChar(120)
  before      Json?
  after       Json?
  reason      String?
  metadata    Json?
  actorUser   User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model FileRecord {
  movementEvidence     CustomerStockMovement[]
  id                   String                     @id @default(uuid()) @db.Uuid
  filename             String                     @db.VarChar(255)
  mimeType             String                     @db.VarChar(160)
  size                 BigInt
  storageKey           String                     @unique @db.VarChar(500)
  storageProvider      StorageProvider
  documentType         String                     @db.VarChar(80)
  uploadedById         String?                    @db.Uuid
  uploadedBy           User?                      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  quotationDocument    SupplierQuotationDocument?
  goodsReceiptDocument GoodsReceiptDocument?
  scanStatus           FileScanStatus             @default(QUARANTINED)
  scanProvider         String?                    @db.VarChar(80)
  scanReference        String?                    @db.VarChar(500)
  scannedAt            DateTime?
  retentionUntil       DateTime                   @db.Date
  uploadedAt           DateTime                   @default(now())

  @@index([uploadedById, uploadedAt])
  @@index([documentType, uploadedAt])
  @@index([scanStatus, uploadedAt])
  @@index([retentionUntil])
}

model PurchaseOrderAmendment {
  id                           String                       @id @default(uuid()) @db.Uuid
  purchaseOrderId              String                       @db.Uuid
  version                      Int
  status                       PurchaseOrderAmendmentStatus @default(DRAFT)
  reason                       String                       @db.VarChar(1000)
  proposedExpectedDeliveryDate DateTime                     @db.Date
  proposedPaymentTerms         String                       @db.VarChar(500)
  proposedFreightAmount        Decimal                      @db.Decimal(18, 2)
  createdById                  String                       @db.Uuid
  submittedAt                  DateTime?
  decidedById                  String?                      @db.Uuid
  decidedAt                    DateTime?
  decisionReason               String?                      @db.VarChar(1000)
  purchaseOrder                PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  createdBy                    User                         @relation("PurchaseOrderAmendmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  decidedBy                    User?                        @relation("PurchaseOrderAmendmentDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  lines                        PurchaseOrderAmendmentLine[]
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  @@unique([purchaseOrderId, version])
  @@index([purchaseOrderId, status])
  @@index([decidedById, decidedAt])
}

model PurchaseOrderAmendmentLine {
  id                  String                 @id @default(uuid()) @db.Uuid
  amendmentId         String                 @db.Uuid
  purchaseOrderLineId String                 @db.Uuid
  proposedQuantity    Decimal                @db.Decimal(18, 3)
  proposedUnitPrice   Decimal                @db.Decimal(18, 2)
  amendment           PurchaseOrderAmendment @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine      @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now())

  @@unique([amendmentId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
}

model GoodsReceiptDocument {
  id             String                   @id @default(uuid()) @db.Uuid
  goodsReceiptId String                   @db.Uuid
  fileRecordId   String                   @unique @db.Uuid
  type           GoodsReceiptDocumentType
  goodsReceipt   GoodsReceipt             @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  fileRecord     FileRecord               @relation(fields: [fileRecordId], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())

  @@index([goodsReceiptId, type])
}

model TemporaryNegativeStockException {
  id                      String                       @id @default(uuid()) @db.Uuid
  locationId              String                       @db.Uuid
  materialId              String                       @db.Uuid
  unitId                  String                       @db.Uuid
  sourceTransactionId     String                       @unique @db.Uuid
  deficitQuantity         Decimal                      @db.Decimal(18, 3)
  reason                  String                       @db.VarChar(1000)
  createdById             String                       @db.Uuid
  detectedAt              DateTime                     @default(now())
  resolutionDueAt         DateTime
  status                  NegativeStockExceptionStatus @default(OPEN)
  resolutionTransactionId String?                      @db.Uuid
  resolvedAt              DateTime?
  location                InventoryLocation            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material                Material                     @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unit                    UnitOfMeasure                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceTransaction       StockTransaction             @relation("NegativeStockSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Restrict)
  resolutionTransaction   StockTransaction?            @relation("NegativeStockResolutionTransaction", fields: [resolutionTransactionId], references: [id], onDelete: Restrict)
  createdBy               User                         @relation("NegativeStockExceptionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, resolutionDueAt])
  @@index([locationId, materialId, status])
}

model BusinessSequence {
  prefix       String   @db.VarChar(12)
  year         Int
  currentValue BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@id([prefix, year])
}

model RateLimitBucket {
  keyHash     String   @id @db.Char(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Client {
  id         String    @id @default(uuid()) @db.Uuid
  clientCode String    @unique @db.VarChar(50)
  name       String    @unique @db.VarChar(180)
  address    String?
  city       String?   @db.VarChar(120)
  state      String?   @db.VarChar(120)
  postalCode String?   @db.VarChar(12)
  phone      String?   @db.VarChar(30)
  email      String?   @db.VarChar(320)
  isActive   Boolean   @default(true)
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, name])
}

model Project {
  stockClosure           ProjectStockClosure?
  id                     String                @id @default(uuid()) @db.Uuid
  projectCode            String                @unique @db.VarChar(50)
  name                   String                @db.VarChar(180)
  clientId               String                @db.Uuid
  location               String                @db.VarChar(240)
  description            String?
  status                 ProjectStatus         @default(PLANNING)
  startDate              DateTime?             @db.Date
  expectedCompletionDate DateTime?             @db.Date
  actualCompletionDate   DateTime?             @db.Date
  procurementBudget      Decimal?              @db.Decimal(18, 2)
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sites                  Site[]
  assignments            ProjectAssignment[]
  materialRequirements   MaterialRequirement[]
  inventoryLocations     InventoryLocation[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([clientId])
  @@index([status, name])
  @@index([startDate, expectedCompletionDate])
}

model Site {
  id                   String                @id @default(uuid()) @db.Uuid
  siteCode             String                @db.VarChar(50)
  name                 String                @db.VarChar(180)
  projectId            String                @db.Uuid
  location             String                @db.VarChar(240)
  address              String?
  description          String?
  status               SiteStatus            @default(PLANNING)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments          SiteAssignment[]
  materialRequirements MaterialRequirement[]
  inventoryLocations   InventoryLocation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([projectId, siteCode])
  @@unique([id, projectId])
  @@index([projectId, status])
  @@index([status, name])
}

model ProjectAssignment {
  id         String                @id @default(uuid()) @db.Uuid
  projectId  String                @db.Uuid
  employeeId String                @db.Uuid
  role       ProjectAssignmentRole
  isPrimary  Boolean               @default(false)
  isActive   Boolean               @default(true)
  startsAt   DateTime              @default(now())
  endsAt     DateTime?
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([projectId, employeeId, role])
  @@index([projectId, isActive, role])
  @@index([employeeId, isActive])
}

model SiteAssignment {
  id         String             @id @default(uuid()) @db.Uuid
  siteId     String             @db.Uuid
  employeeId String             @db.Uuid
  role       SiteAssignmentRole
  isPrimary  Boolean            @default(false)
  isActive   Boolean            @default(true)
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([siteId, employeeId, role])
  @@index([siteId, isActive, role])
  @@index([employeeId, isActive])
}

model MaterialCategory {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @unique @db.VarChar(120)
  description String?
  isActive    Boolean    @default(true)
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, name])
}

model UnitOfMeasure {
  customerMovements       CustomerStockMovement[]
  id                      String                            @id @default(uuid()) @db.Uuid
  code                    String                            @unique @db.VarChar(30)
  name                    String                            @unique @db.VarChar(80)
  symbol                  String                            @db.VarChar(20)
  description             String?
  decimalScale            Int                               @default(3)
  isActive                Boolean                           @default(true)
  materials               Material[]
  requirementLines        MaterialRequirementLine[]
  quotationLines          SupplierQuotationLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceiptLines       GoodsReceiptLine[]
  stockTransactions       StockTransaction[]
  negativeStockExceptions TemporaryNegativeStockException[]
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@index([isActive, name])
}

model Material {
  customerMovements       CustomerStockMovement[]
  id                      String                            @id @default(uuid()) @db.Uuid
  materialCode            String                            @unique @db.VarChar(50)
  name                    String                            @db.VarChar(180)
  description             String?
  categoryId              String                            @db.Uuid
  defaultUnitId           String                            @db.Uuid
  minimumStockLevel       Decimal                           @default(0) @db.Decimal(18, 3)
  reorderLevel            Decimal                           @default(0) @db.Decimal(18, 3)
  isActive                Boolean                           @default(true)
  category                MaterialCategory                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultUnit             UnitOfMeasure                     @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  requirementLines        MaterialRequirementLine[]
  goodsReceiptLines       GoodsReceiptLine[]
  negativeStockExceptions TemporaryNegativeStockException[]
  stockTransactions       StockTransaction[]
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@unique([name, defaultUnitId])
  @@index([categoryId, isActive])
  @@index([defaultUnitId])
  @@index([isActive, name])
}

model Supplier {
  id                           String                        @id @default(uuid()) @db.Uuid
  supplierCode                 String                        @unique @db.VarChar(50)
  legalName                    String                        @db.VarChar(180)
  tradeName                    String?                       @db.VarChar(180)
  gstin                        String?                       @unique @db.VarChar(15)
  address                      String?
  city                         String                        @db.VarChar(120)
  state                        String                        @db.VarChar(120)
  postalCode                   String?                       @db.VarChar(12)
  phone                        String?                       @db.VarChar(30)
  email                        String?                       @db.VarChar(320)
  isGstRegistered              Boolean                       @default(false)
  accountsApprovedUnregistered Boolean                       @default(false)
  defaultCreditDays            Int                           @default(30)
  isActive                     Boolean                       @default(true)
  contacts                     SupplierContact[]
  rfqInvitations               RequestForQuotationSupplier[]
  quotations                   SupplierQuotation[]
  purchaseOrders               PurchaseOrder[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@unique([legalName, city])
  @@index([isActive, legalName])
  @@index([state, city])
}

model SupplierContact {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  name        String   @db.VarChar(160)
  designation String?  @db.VarChar(120)
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(320)
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId, isActive])
}

model MaterialRequirement {
  id                   String                             @id @default(uuid()) @db.Uuid
  requirementNumber    String                             @unique @db.VarChar(30)
  projectId            String                             @db.Uuid
  siteId               String                             @db.Uuid
  status               MaterialRequirementStatus          @default(DRAFT)
  neededBy             DateTime                           @db.Date
  purpose              String                             @db.VarChar(500)
  notes                String?
  createdById          String                             @db.Uuid
  submittedById        String?                            @db.Uuid
  submittedByRole      MaterialRequirementSubmitterRole?
  submittedAt          DateTime?
  decidedById          String?                            @db.Uuid
  decidedAt            DateTime?
  decisionReason       String?                            @db.VarChar(1000)
  project              Project                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site                 Site                               @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy            User                               @relation("MaterialRequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy          User?                              @relation("MaterialRequirementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
