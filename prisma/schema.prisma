  acceptedRecordedById        String?                  @db.Uuid
  closedById                  String?                  @db.Uuid
  closedAt                    DateTime?
  cancelledById               String?                  @db.Uuid
  cancelledAt                 DateTime?
  cancellationReason          String?                  @db.VarChar(1000)
  shortCloseReason            String?                  @db.VarChar(1000)
  rfq                         RequestForQuotation      @relation(fields: [rfqId], references: [id], onDelete: Restrict)
