// Additive Phase 6 records; Phase 5 models and migration history are retained.
model CustomerStockMovement {
  id                    String                    @id @default(uuid()) @db.Uuid
  number                String                    @unique @db.VarChar(30)
  kind                  String                    @db.VarChar(20)
  status                String                    @default("REQUESTED") @db.VarChar(20)
  sourceLocationId      String                    @db.Uuid
  destinationLocationId String?                   @db.Uuid
  materialId            String                    @db.Uuid
  unitId                String                    @db.Uuid
  quantity              Decimal                   @db.Decimal(18, 3)
  approvedQuantity      Decimal?                  @db.Decimal(18, 3)
  actualQuantity        Decimal?                  @db.Decimal(18, 3)
  bookQuantity          Decimal?                  @db.Decimal(18, 3)
  unitCost              Decimal?                  @db.Decimal(24, 6)
  reason                String                    @db.VarChar(1000)
  transitionReason      String                    @db.VarChar(1000)
  evidenceId            String?                   @db.Uuid
  latitude              Decimal?                  @db.Decimal(9, 6)
  longitude             Decimal?                  @db.Decimal(9, 6)
  gpsCapturedAt         DateTime?
  receiptLatitude       Decimal?                  @db.Decimal(9, 6)
  receiptLongitude      Decimal?                  @db.Decimal(9, 6)
  receiptGpsCapturedAt  DateTime?
  category              String?                   @db.VarChar(20)
  direction             String                    @default("OUT") @db.VarChar(3)
  disposition           String                    @default("DISPOSAL") @db.VarChar(10)
  originalIssueId       String?                   @db.Uuid
  varianceOfId          String?                   @unique @db.Uuid
  correctionOfId        String?                   @db.Uuid
  closureProjectId      String?                   @db.Uuid
  createdById           String                    @db.Uuid
  updatedById           String                    @db.Uuid
  approvedById          String?                   @db.Uuid
  dispatchedById        String?                   @db.Uuid
  approvedAt            DateTime?
  dispatchedAt          DateTime?
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  source                InventoryLocation         @relation("MovementSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destination           InventoryLocation?        @relation("MovementDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  material              Material                  @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unit                  UnitOfMeasure             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  evidence              FileRecord?               @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  createdBy             User                      @relation("MovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                      @relation("MovementActor", fields: [updatedById], references: [id], onDelete: Restrict)
  approvedBy            User?                     @relation("MovementApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  dispatchedBy          User?                     @relation("MovementDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict)
  originalIssue         CustomerStockMovement?    @relation("IssueReturns", fields: [originalIssueId], references: [id], onDelete: Restrict)
  returns               CustomerStockMovement[]   @relation("IssueReturns")
  varianceOf            CustomerStockMovement?    @relation("MovementVariance", fields: [varianceOfId], references: [id], onDelete: Restrict)
  variance              CustomerStockMovement?    @relation("MovementVariance")
  correctionOf          CustomerStockMovement?    @relation("MovementCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections           CustomerStockMovement[]   @relation("MovementCorrection")
  closure               ProjectStockClosure?      @relation(fields: [closureProjectId], references: [projectId], onDelete: Restrict)
  postings              CustomerMovementPosting[]

  @@index([sourceLocationId, materialId, status])
  @@index([destinationLocationId, status])
  @@index([originalIssueId, status])
  @@index([closureProjectId, status])
}

model CustomerMovementPosting {
