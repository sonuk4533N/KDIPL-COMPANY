  stockCountLine      StockCountLine?         @relation(fields: [stockCountLineId], references: [id], onDelete: Restrict)
  reconciliation      MaterialReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reversalOf          StockTransaction?       @relation("StockTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals           StockTransaction[]      @relation("StockTransactionReversal")
  createdBy           User                    @relation("StockTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now())

  @@index([locationId, materialId, createdAt])
  @@index([materialId, createdAt])
  @@index([materialIssueLineId])
  @@index([stockTransferLineId])
}
