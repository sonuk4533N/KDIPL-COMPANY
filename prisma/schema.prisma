// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  SEND_BACK
  RECOMMEND
  CANCEL
  VERIFY
  RECEIVE
  ISSUE
  TRANSFER
  ADJUST
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
}

enum StorageProvider {
  LOCAL
  S3
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum SiteStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectAssignmentRole {
  PROJECT_MANAGER
  PROJECT_MEMBER
}

enum SiteAssignmentRole {
  SITE_SUPERVISOR
  SITE_MEMBER
}

enum MaterialRequirementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaterialRequirementSubmitterRole {
  SITE_SUPERVISOR
  PROJECT_MANAGER
}

enum MaterialRequirementWorkflowAction {
  SUBMIT
  APPROVE
  REJECT
  SEND_BACK
}

enum RequestForQuotationStatus {
  DRAFT
  ISSUED
  RECOMMENDED
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestForQuotationWorkflowAction {
  ISSUE
  RECOMMEND
  APPROVE
  REJECT
  SEND_BACK
  CANCEL
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  ACCEPTED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum InventoryLocationType {
  CENTRAL_STORE
  PROJECT_STORE
  SITE_STORE
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum GoodsReceiptExceptionType {
  DAMAGED
  REJECTED
}

enum GoodsReceiptExceptionStatus {
  OPEN
  REPLACEMENT_EXPECTED
  RETURN_PENDING
  RETURNED
  RESOLVED
}

enum StockTransactionType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @unique @db.VarChar(120)
  description String?
  isActive    Boolean    @default(true)
  employees   Employee[]
  positions   Position[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  code         String      @unique @db.VarChar(50)
  name         String      @unique @db.VarChar(120)
  description  String?
  isActive     Boolean     @default(true)
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
  @@index([isActive])
}

model Employee {
  id                 String              @id @default(uuid()) @db.Uuid
  employeeCode       String              @unique @db.VarChar(50)
  fullName           String              @db.VarChar(160)
  designation        String?             @db.VarChar(120)
  email              String?             @db.VarChar(320)
  mobile             String?             @db.VarChar(30)
  isActive           Boolean             @default(true)
  departmentId       String?             @db.Uuid
  positionId         String?             @db.Uuid
  managerId          String?             @db.Uuid
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?           @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("EmployeeManager")
  user               User?
  projectAssignments ProjectAssignment[]
  siteAssignments    SiteAssignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([isActive])
}

model User {
  id                              String                             @id @default(uuid()) @db.Uuid
  email                           String                             @db.VarChar(320)
  emailNormalized                 String                             @unique @db.VarChar(320)
  passwordHash                    String
  displayName                     String                             @db.VarChar(160)
  status                          UserStatus                         @default(ACTIVE)
  authVersion                     Int                                @default(1)
  mustChangePassword              Boolean                            @default(false)
  passwordChangedAt               DateTime?
  lastLoginAt                     DateTime?
  employeeId                      String?                            @unique @db.Uuid
  employee                        Employee?                          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles                           UserRole[]
  sessions                        Session[]
  auditEvents                     AuditLog[]                         @relation("AuditActor")
  uploadedFiles                   FileRecord[]
  materialRequirementsCreated     MaterialRequirement[]              @relation("MaterialRequirementCreator")
  materialRequirementsSubmitted   MaterialRequirement[]              @relation("MaterialRequirementSubmitter")
  materialRequirementsDecided     MaterialRequirement[]              @relation("MaterialRequirementDecisionActor")
  materialRequirementEvents       MaterialRequirementWorkflowEvent[]
  requestsForQuotationCreated     RequestForQuotation[]              @relation("RequestForQuotationCreator")
  requestsForQuotationIssued      RequestForQuotation[]              @relation("RequestForQuotationIssuer")
  requestsForQuotationRecommended RequestForQuotation[]              @relation("RequestForQuotationRecommender")
  requestsForQuotationDecided     RequestForQuotation[]              @relation("RequestForQuotationDecisionActor")
  requestForQuotationEvents       RequestForQuotationWorkflowEvent[]
  supplierQuotationsRecorded      SupplierQuotation[]                @relation("SupplierQuotationRecorder")
  purchaseOrdersCreated           PurchaseOrder[]                    @relation("PurchaseOrderCreator")
  purchaseOrdersIssued            PurchaseOrder[]                    @relation("PurchaseOrderIssuer")
  purchaseOrderAcceptancesRecorded PurchaseOrder[]                   @relation("PurchaseOrderAcceptanceRecorder")
  purchaseOrdersClosed            PurchaseOrder[]                    @relation("PurchaseOrderCloser")
  purchaseOrdersCancelled         PurchaseOrder[]                    @relation("PurchaseOrderCanceller")
  goodsReceiptsCreated            GoodsReceipt[]                     @relation("GoodsReceiptCreator")
  goodsReceiptsPosted             GoodsReceipt[]                     @relation("GoodsReceiptPoster")
  goodsReceiptsCancelled          GoodsReceipt[]                     @relation("GoodsReceiptCanceller")
  stockTransactionsCreated        StockTransaction[]                 @relation("StockTransactionCreator")
  createdAt                       DateTime                            @default(now())
  updatedAt                       DateTime                            @updatedAt

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @unique @db.VarChar(120)
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  userId            String    @db.Uuid
  authVersion       Int
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  userAgent         String?   @db.VarChar(500)
  ipHash            String?   @db.Char(64)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String      @db.VarChar(120)
  entityId    String      @db.VarChar(120)
  before      Json?
  after       Json?
  reason      String?
  metadata    Json?
  actorUser   User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model FileRecord {
  id                String                     @id @default(uuid()) @db.Uuid
  filename          String                     @db.VarChar(255)
  mimeType          String                     @db.VarChar(160)
  size              BigInt
  storageKey        String                     @unique @db.VarChar(500)
  storageProvider   StorageProvider
  documentType      String                     @db.VarChar(80)
  uploadedById      String?                    @db.Uuid
  uploadedBy        User?                      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  quotationDocument SupplierQuotationDocument?
  uploadedAt        DateTime                   @default(now())

  @@index([uploadedById, uploadedAt])
  @@index([documentType, uploadedAt])
}

model BusinessSequence {
  prefix       String   @db.VarChar(12)
  year         Int
  currentValue BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@id([prefix, year])
}

model RateLimitBucket {
  keyHash     String   @id @db.Char(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model Client {
  id         String    @id @default(uuid()) @db.Uuid
  clientCode String    @unique @db.VarChar(50)
  name       String    @unique @db.VarChar(180)
  address    String?
  city       String?   @db.VarChar(120)
  state      String?   @db.VarChar(120)
  postalCode String?   @db.VarChar(12)
  phone      String?   @db.VarChar(30)
  email      String?   @db.VarChar(320)
  isActive   Boolean   @default(true)
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, name])
}

model Project {
  id                     String                @id @default(uuid()) @db.Uuid
  projectCode            String                @unique @db.VarChar(50)
  name                   String                @db.VarChar(180)
  clientId               String                @db.Uuid
  location               String                @db.VarChar(240)
  description            String?
  status                 ProjectStatus         @default(PLANNING)
  startDate              DateTime?             @db.Date
  expectedCompletionDate DateTime?             @db.Date
  actualCompletionDate   DateTime?             @db.Date
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sites                  Site[]
  assignments            ProjectAssignment[]
  materialRequirements   MaterialRequirement[]
  inventoryLocations     InventoryLocation[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([clientId])
  @@index([status, name])
  @@index([startDate, expectedCompletionDate])
}

model Site {
  id                   String                @id @default(uuid()) @db.Uuid
  siteCode             String                @db.VarChar(50)
  name                 String                @db.VarChar(180)
  projectId            String                @db.Uuid
  location             String                @db.VarChar(240)
  address              String?
  description          String?
  status               SiteStatus            @default(PLANNING)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments          SiteAssignment[]
  materialRequirements MaterialRequirement[]
  inventoryLocations   InventoryLocation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([projectId, siteCode])
  @@unique([id, projectId])
  @@index([projectId, status])
  @@index([status, name])
}

model ProjectAssignment {
  id         String                @id @default(uuid()) @db.Uuid
  projectId  String                @db.Uuid
  employeeId String                @db.Uuid
  role       ProjectAssignmentRole
  isPrimary  Boolean               @default(false)
  isActive   Boolean               @default(true)
  startsAt   DateTime              @default(now())
  endsAt     DateTime?
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([projectId, employeeId, role])
  @@index([projectId, isActive, role])
  @@index([employeeId, isActive])
}

model SiteAssignment {
  id         String             @id @default(uuid()) @db.Uuid
  siteId     String             @db.Uuid
  employeeId String             @db.Uuid
  role       SiteAssignmentRole
  isPrimary  Boolean            @default(false)
  isActive   Boolean            @default(true)
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([siteId, employeeId, role])
  @@index([siteId, isActive, role])
  @@index([employeeId, isActive])
}

model MaterialCategory {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @unique @db.VarChar(120)
  description String?
  isActive    Boolean    @default(true)
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, name])
}

model UnitOfMeasure {
  id                 String                    @id @default(uuid()) @db.Uuid
  code               String                    @unique @db.VarChar(30)
  name               String                    @unique @db.VarChar(80)
  symbol             String                    @db.VarChar(20)
  description        String?
  decimalScale       Int                       @default(3)
  isActive           Boolean                   @default(true)
  materials          Material[]
  requirementLines   MaterialRequirementLine[]
  quotationLines     SupplierQuotationLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockTransactions  StockTransaction[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([isActive, name])
}

model Material {
  id                String                    @id @default(uuid()) @db.Uuid
  materialCode      String                    @unique @db.VarChar(50)
  name              String                    @db.VarChar(180)
  description       String?
  categoryId        String                    @db.Uuid
  defaultUnitId     String                    @db.Uuid
  minimumStockLevel Decimal                   @default(0) @db.Decimal(18, 3)
  reorderLevel      Decimal                   @default(0) @db.Decimal(18, 3)
  isActive          Boolean                   @default(true)
  category          MaterialCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  defaultUnit       UnitOfMeasure             @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  requirementLines  MaterialRequirementLine[]
  goodsReceiptLines GoodsReceiptLine[]
  stockTransactions StockTransaction[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([name, defaultUnitId])
  @@index([categoryId, isActive])
  @@index([defaultUnitId])
  @@index([isActive, name])
}

model Supplier {
  id              String                        @id @default(uuid()) @db.Uuid
  supplierCode    String                        @unique @db.VarChar(50)
  legalName       String                        @db.VarChar(180)
  tradeName       String?                       @db.VarChar(180)
  gstin           String?                       @unique @db.VarChar(15)
  address         String?
  city            String                        @db.VarChar(120)
  state           String                        @db.VarChar(120)
  postalCode      String?                       @db.VarChar(12)
  phone           String?                       @db.VarChar(30)
  email           String?                       @db.VarChar(320)
  isGstRegistered Boolean                       @default(false)
  isActive        Boolean                       @default(true)
  contacts        SupplierContact[]
  rfqInvitations  RequestForQuotationSupplier[]
  quotations      SupplierQuotation[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@unique([legalName, city])
  @@index([isActive, legalName])
  @@index([state, city])
}

model SupplierContact {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  name        String   @db.VarChar(160)
  designation String?  @db.VarChar(120)
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(320)
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId, isActive])
}

model MaterialRequirement {
  id                   String                             @id @default(uuid()) @db.Uuid
  requirementNumber    String                             @unique @db.VarChar(30)
  projectId            String                             @db.Uuid
  siteId               String                             @db.Uuid
  status               MaterialRequirementStatus          @default(DRAFT)
  neededBy             DateTime                           @db.Date
  purpose              String                             @db.VarChar(500)
  notes                String?
  createdById          String                             @db.Uuid
  submittedById        String?                            @db.Uuid
  submittedByRole      MaterialRequirementSubmitterRole?
  submittedAt          DateTime?
  decidedById          String?                            @db.Uuid
  decidedAt            DateTime?
  decisionReason       String?                            @db.VarChar(1000)
  project              Project                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site                 Site                               @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy            User                               @relation("MaterialRequirementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy          User?                              @relation("MaterialRequirementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedBy            User?                              @relation("MaterialRequirementDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  lines                MaterialRequirementLine[]
  workflowEvents       MaterialRequirementWorkflowEvent[]
  requestsForQuotation RequestForQuotation[]
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  @@index([projectId, status, neededBy])
  @@index([siteId, status])
  @@index([createdById, createdAt])
  @@index([submittedById, submittedAt])
  @@index([decidedById, decidedAt])
}

model MaterialRequirementLine {
  id                 String                  @id @default(uuid()) @db.Uuid
  requirementId      String                  @db.Uuid
  materialId         String                  @db.Uuid
  unitId             String                  @db.Uuid
  quantity           Decimal                 @db.Decimal(18, 3)
  notes              String?                 @db.VarChar(500)
  position           Int                     @default(0)
  isActive           Boolean                 @default(true)
  requirement        MaterialRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  material           Material                @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unit               UnitOfMeasure           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  quotationLines     SupplierQuotationLine[]
  purchaseOrderLines PurchaseOrderLine[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([requirementId, materialId])
  @@index([requirementId, isActive, position])
  @@index([materialId])
  @@index([unitId])
}

model MaterialRequirementWorkflowEvent {
  id            String                            @id @default(uuid()) @db.Uuid
  requirementId String                            @db.Uuid
  action        MaterialRequirementWorkflowAction
  fromStatus    MaterialRequirementStatus
  toStatus      MaterialRequirementStatus
  actorUserId   String                            @db.Uuid
  reason        String?                           @db.VarChar(1000)
  requirement   MaterialRequirement               @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  actorUser     User                              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime                          @default(now())

  @@index([requirementId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model RequestForQuotation {
  id                     String                             @id @default(uuid()) @db.Uuid
  rfqNumber              String                             @unique @db.VarChar(30)
  requirementId          String                             @db.Uuid
  status                 RequestForQuotationStatus          @default(DRAFT)
  responseDueDate        DateTime                           @db.Date
  notes                  String?
  createdById            String                             @db.Uuid
  issuedById             String?                            @db.Uuid
  issuedAt               DateTime?
  recommendedQuotationId String?                            @unique @db.Uuid
  recommendedById        String?                            @db.Uuid
  recommendedAt          DateTime?
  recommendationReason   String?                            @db.VarChar(1000)
  decidedById            String?                            @db.Uuid
  decidedAt              DateTime?
  decisionReason         String?                            @db.VarChar(1000)
  requirement            MaterialRequirement                @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  createdBy              User                               @relation("RequestForQuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy               User?                              @relation("RequestForQuotationIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  recommendedQuotation   SupplierQuotation?                 @relation("RecommendedQuotation", fields: [recommendedQuotationId], references: [id], onDelete: Restrict)
  recommendedBy          User?                              @relation("RequestForQuotationRecommender", fields: [recommendedById], references: [id], onDelete: Restrict)
  decidedBy              User?                              @relation("RequestForQuotationDecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)
  invitedSuppliers       RequestForQuotationSupplier[]
  quotations             SupplierQuotation[]                @relation("RfqQuotations")
  workflowEvents         RequestForQuotationWorkflowEvent[]
  purchaseOrder          PurchaseOrder?
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt

  @@index([requirementId, status])
  @@index([status, responseDueDate])
  @@index([createdById, createdAt])
  @@index([issuedById, issuedAt])
  @@index([recommendedById, recommendedAt])
  @@index([decidedById, decidedAt])
}

model RequestForQuotationSupplier {
  rfqId      String              @db.Uuid
  supplierId String              @db.Uuid
  isActive   Boolean             @default(true)
  rfq        RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@id([rfqId, supplierId])
  @@index([rfqId, isActive])
  @@index([supplierId])
}

model RequestForQuotationWorkflowEvent {
  id          String                            @id @default(uuid()) @db.Uuid
  rfqId       String                            @db.Uuid
  action      RequestForQuotationWorkflowAction
  fromStatus  RequestForQuotationStatus
  toStatus    RequestForQuotationStatus
  actorUserId String                            @db.Uuid
  reason      String?                           @db.VarChar(1000)
  rfq         RequestForQuotation               @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  actorUser   User                              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime                          @default(now())

  @@index([rfqId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model SupplierQuotation {
  id                  String                      @id @default(uuid()) @db.Uuid
  rfqId               String                      @db.Uuid
  supplierId          String                      @db.Uuid
  quoteReference      String                      @db.VarChar(100)
  quoteDate           DateTime                    @db.Date
  validUntil          DateTime                    @db.Date
  offeredDeliveryDate DateTime                    @db.Date
  paymentTerms        String                      @db.VarChar(500)
  currency            String                      @default("INR") @db.Char(3)
  subtotal            Decimal                     @db.Decimal(18, 2)
  gstRate             Decimal                     @db.Decimal(5, 2)
  gstAmount           Decimal                     @db.Decimal(18, 2)
  freightAmount       Decimal                     @default(0) @db.Decimal(18, 2)
  landedTotal         Decimal                     @db.Decimal(18, 2)
  notes               String?
  recordedById        String                      @db.Uuid
  rfq                 RequestForQuotation         @relation("RfqQuotations", fields: [rfqId], references: [id], onDelete: Restrict)
  supplier            Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recordedBy          User                        @relation("SupplierQuotationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  lines               SupplierQuotationLine[]
  documents           SupplierQuotationDocument[]
  recommendedFor      RequestForQuotation?        @relation("RecommendedQuotation")
  purchaseOrder       PurchaseOrder?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([rfqId, supplierId])
  @@unique([supplierId, quoteReference])
  @@index([rfqId, landedTotal])
  @@index([supplierId, quoteDate])
  @@index([recordedById, createdAt])
}

model SupplierQuotationLine {
  id                String                  @id @default(uuid()) @db.Uuid
  quotationId       String                  @db.Uuid
  requirementLineId String                  @db.Uuid
  unitId            String                  @db.Uuid
  quantity          Decimal                 @db.Decimal(18, 3)
  unitPrice         Decimal                 @db.Decimal(18, 2)
  lineSubtotal      Decimal                 @db.Decimal(18, 2)
  quotation         SupplierQuotation       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  requirementLine   MaterialRequirementLine @relation(fields: [requirementLineId], references: [id], onDelete: Restrict)
  unit              UnitOfMeasure           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine?
  createdAt         DateTime                @default(now())

  @@unique([quotationId, requirementLineId])
  @@index([requirementLineId])
  @@index([unitId])
}

model SupplierQuotationDocument {
  id           String            @id @default(uuid()) @db.Uuid
  quotationId  String            @db.Uuid
  fileRecordId String            @unique @db.Uuid
  quotation    SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  fileRecord   FileRecord        @relation(fields: [fileRecordId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())

  @@index([quotationId, createdAt])
}

model PurchaseOrder {
  id                          String              @id @default(uuid()) @db.Uuid
  poNumber                    String              @unique @db.VarChar(30)
  rfqId                       String              @unique @db.Uuid
  quotationId                 String              @unique @db.Uuid
  supplierId                  String              @db.Uuid
  status                      PurchaseOrderStatus @default(DRAFT)
  currency                    String              @default("INR") @db.Char(3)
  subtotal                    Decimal             @db.Decimal(18, 2)
  gstRate                     Decimal             @db.Decimal(5, 2)
  gstAmount                   Decimal             @db.Decimal(18, 2)
  freightAmount               Decimal             @db.Decimal(18, 2)
  totalAmount                 Decimal             @db.Decimal(18, 2)
  expectedDeliveryDate        DateTime            @db.Date
  paymentTerms                String              @db.VarChar(500)
  createdById                 String              @db.Uuid
  issuedById                  String?             @db.Uuid
  issuedAt                    DateTime?
  supplierAcceptedAt          DateTime?
  supplierAcceptanceReference String?             @db.VarChar(100)
  acceptedRecordedById        String?             @db.Uuid
  closedById                  String?             @db.Uuid
  closedAt                    DateTime?
  cancelledById               String?             @db.Uuid
  cancelledAt                 DateTime?
  cancellationReason          String?             @db.VarChar(1000)
  rfq                         RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  quotation                   SupplierQuotation   @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  supplier                    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy                   User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy                    User?               @relation("PurchaseOrderIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  acceptedRecordedBy          User?               @relation("PurchaseOrderAcceptanceRecorder", fields: [acceptedRecordedById], references: [id], onDelete: Restrict)
  closedBy                    User?               @relation("PurchaseOrderCloser", fields: [closedById], references: [id], onDelete: Restrict)
  cancelledBy                 User?               @relation("PurchaseOrderCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines                       PurchaseOrderLine[]
  goodsReceipts               GoodsReceipt[]
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@index([supplierId, status])
  @@index([createdById, createdAt])
  @@index([issuedById, issuedAt])
  @@index([acceptedRecordedById, supplierAcceptedAt])
  @@index([status, expectedDeliveryDate])
}

model PurchaseOrderLine {
  id                String                  @id @default(uuid()) @db.Uuid
  purchaseOrderId   String                  @db.Uuid
  quotationLineId   String                  @unique @db.Uuid
  requirementLineId String                  @db.Uuid
  unitId            String                  @db.Uuid
  quantity          Decimal                 @db.Decimal(18, 3)
  unitPrice         Decimal                 @db.Decimal(18, 2)
  lineSubtotal      Decimal                 @db.Decimal(18, 2)
  position          Int                     @default(0)
  purchaseOrder     PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  quotation         SupplierQuotationLine   @relation(fields: [quotationLineId], references: [id], onDelete: Restrict)
  requirementLine   MaterialRequirementLine @relation(fields: [requirementLineId], references: [id], onDelete: Restrict)
  unit              UnitOfMeasure           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]
  createdAt         DateTime                @default(now())

  @@unique([purchaseOrderId, requirementLineId])
  @@index([purchaseOrderId, position])
  @@index([requirementLineId])
  @@index([unitId])
}

model InventoryLocation {
  id                String                @id @default(uuid()) @db.Uuid
  locationCode      String                @unique @db.VarChar(50)
  name              String                @db.VarChar(180)
  type              InventoryLocationType
  projectId         String?               @db.Uuid
  siteId            String?               @db.Uuid
  isActive          Boolean               @default(true)
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site              Site?                 @relation(fields: [siteId, projectId], references: [id, projectId], onDelete: Restrict)
  goodsReceipts     GoodsReceipt[]
  stockTransactions StockTransaction[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([projectId, isActive])
  @@index([siteId, isActive])
}

model GoodsReceipt {
  id                       String             @id @default(uuid()) @db.Uuid
  grnNumber                String             @unique @db.VarChar(30)
  purchaseOrderId          String             @db.Uuid
  locationId               String             @db.Uuid
  status                   GoodsReceiptStatus @default(DRAFT)
  supplierDeliveryNote     String?            @db.VarChar(100)
  supplierDeliveryNoteDate DateTime?          @db.Date
  vehicleNumber            String?            @db.VarChar(50)
  transporter              String?            @db.VarChar(160)
  receivedAt               DateTime?
  notes                    String?
  createdById              String             @db.Uuid
  postedById               String?            @db.Uuid
  postedAt                 DateTime?
  cancelledById            String?            @db.Uuid
  cancelledAt              DateTime?
  cancellationReason       String?            @db.VarChar(1000)
  purchaseOrder            PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  location                 InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy                User               @relation("GoodsReceiptCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy                 User?              @relation("GoodsReceiptPoster", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledBy              User?              @relation("GoodsReceiptCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines                    GoodsReceiptLine[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([purchaseOrderId, status])
  @@index([locationId, status])
}

model GoodsReceiptLine {
  id                  String             @id @default(uuid()) @db.Uuid
  goodsReceiptId      String             @db.Uuid
  purchaseOrderLineId String             @db.Uuid
  materialId          String             @db.Uuid
  unitId              String             @db.Uuid
  orderedQuantity     Decimal            @db.Decimal(18, 3)
  receivedQuantity    Decimal            @db.Decimal(18, 3)
  acceptedQuantity    Decimal            @db.Decimal(18, 3)
  damagedQuantity     Decimal            @default(0) @db.Decimal(18, 3)
  rejectedQuantity    Decimal            @default(0) @db.Decimal(18, 3)
  notes               String?            @db.VarChar(500)
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  material            Material           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unit                UnitOfMeasure      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  stockTransactions   StockTransaction[]
  exceptions          GoodsReceiptException[]
  createdAt           DateTime           @default(now())

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([goodsReceiptId])
  @@index([materialId])
}

model GoodsReceiptException {
  id                   String                      @id @default(uuid()) @db.Uuid
  goodsReceiptLineId   String                      @db.Uuid
  type                 GoodsReceiptExceptionType
  quantity             Decimal                     @db.Decimal(18, 3)
  status               GoodsReceiptExceptionStatus @default(OPEN)
  reason               String?                     @db.VarChar(1000)
  evidenceReference    String?                     @db.VarChar(500)
  resolutionNotes      String?                     @db.VarChar(1000)
  goodsReceiptLine     GoodsReceiptLine            @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([goodsReceiptLineId, type])
  @@index([status, createdAt])
}

model StockTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  transactionNumber  String               @unique @db.VarChar(30)
  type               StockTransactionType
  locationId         String               @db.Uuid
  materialId         String               @db.Uuid
  unitId             String               @db.Uuid
  quantity           Decimal              @db.Decimal(18, 3)
  goodsReceiptLineId String?              @db.Uuid
  reversalOfId       String?              @db.Uuid
  reason             String?              @db.VarChar(1000)
  createdById        String               @db.Uuid
  location           InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  material           Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  unit               UnitOfMeasure        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  goodsReceiptLine   GoodsReceiptLine?    @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  reversalOf         StockTransaction?    @relation("StockTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals          StockTransaction[]   @relation("StockTransactionReversal")
  createdBy          User                 @relation("StockTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())

  @@index([locationId, materialId, createdAt])
  @@index([materialId, createdAt])
}
