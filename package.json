{
  "name": "kdipl-operations-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "2fa": "tsx scripts/get-2fa-code.ts",
    "seed:accounts": "tsx scripts/seed-all-accounts.ts",
    "admin:setup": "tsx scripts/setup-full-access-admin.ts",
    "admin:inspect": "tsx scripts/inspect-admin.ts",
    "accounts:inspect": "tsx scripts/inspect-all-accounts.ts",
    "dev": "next dev",
    "build": "next build",
    "release:check": "node --experimental-strip-types scripts/check-production-readiness.ts",
    "security:audit": "npm audit --audit-level=high",
    "security:drill": "tsx scripts/test-quarantine-drill.ts",
    "smoke:test": "tsx scripts/run-smoke-tests.ts",
    "uat:journey": "tsx scripts/run-final-uat-journey.ts",
    "perf:load-test": "tsx scripts/run-load-test.ts",
    "backup:run": "tsx scripts/backup-database.ts",
    "restore:test": "tsx scripts/restore-database.ts",
    "bi:test": "tsx scripts/run-phase12-bi-suite.ts",
    "enterprise:test": "tsx scripts/run-phase13-enterprise-suite.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude tests/integration/**",
    "test:unit": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --exclude tests/integration/**",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
